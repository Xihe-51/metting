# ============ 后端环境变量示例 ============
# 使用方法：复制本文件为 backend/.env，再把 SECRET_KEY 换成自己生成的值。
# .env 属于本地部署配置，不要提交到版本库（仓库根 certs/ 同理）。

# ---------- 必填：JWT 签名密钥 ----------
# 要求：至少 32 个字符，且不能是源码里的示例值；
# 不满足时后端会「拒绝启动」而不是带着弱密钥对外服务。
# 生成方式（任选其一）：
#   python -c "import secrets;print(secrets.token_urlsafe(48))"
#   PowerShell: -join ((1..48) | ForEach-Object { '{0:x}' -f (Get-Random -Max 16) })
SECRET_KEY=please-replace-with-a-random-string-at-least-32-chars

# ---------- 可选：开发联调开关 ----------
# 置为 1 时 /api/v1/auth/send-code 会在响应里回显验证码（仅供本地联调/自动化测试）。
# 生产环境必须保持不设置或置为 0，否则等同于任意账号可被接管。
# AUTH_DEV_MODE=0

# ---------- 可选：HTTPS / WSS（局域网部署强烈建议开启）----------
# 两个变量必须同时配置，且文件真实存在，否则后端启动时报错（避免“以为开了 https 其实没开”）。
# 证书由 backend/scripts/gen_dev_cert.ps1 生成到 <仓库根>/certs/ 下。
# SSL_CERTFILE=D:/meeting/certs/dev-cert.pem
# SSL_KEYFILE=D:/meeting/certs/dev-key.pem

# ---------- 可选：ICE（STUN/TURN，经 /api/v1/config/ice 统一下发）----------
# 纯局域网部署**无需配置**：不下发任何 STUN/TURN 时浏览器只用 host 候选直连，
# 同网段最快，也避免等待不可达的公网 STUN 造成“入会慢、首帧延迟高”。
#
# ICE_STUN_URLS：逗号分隔的 stun:/stuns: 地址；仅当需要跨网段打洞时才配置。
# ICE_STUN_URLS=stun:stun.example.com:3478
#
# TURN_URLS 与 TURN_SECRET 必须**成对**配置，只配一个会导致后端启动报错
# （避免“以为能中继其实没密钥”或“中继无凭证开放”）。
# TURN_SECRET 就是 coturn 的 static-auth-secret；后端据此为每个用户签发
# 带有效期的临时凭证，而不是下发长期密码。TURN_TTL 为凭证有效期（秒，默认 600）。
# 部署示例见 deploy/coturn/turnserver.conf 与 README「TURN 中继部署」一节。
# TURN_URLS=turn:192.168.1.5:3478
# TURN_SECRET=replace-with-the-same-secret-as-turnserver.conf
# TURN_TTL=600

# ---------- 可选：录制配额（磁盘写满防护）----------
# 录制分片是原始二进制上传，没有上限时单个会议创建者即可用脚本把磁盘写满。
# 三个值均为**字节数**，且必须逐级放宽：
#   REC_MAX_CHUNK_BYTES <= REC_MAX_TOTAL_BYTES <= REC_MAX_STORAGE_BYTES
# 不满足时后端启动报错。默认：单片 16MB / 单场 2GB / 目录总计 20GB。
# （1s 分片的实际大小通常只有几十 KB，16MB 的单片上限不会影响正常录制。）
# REC_MAX_CHUNK_BYTES=16777216
# REC_MAX_TOTAL_BYTES=2147483648
# REC_MAX_STORAGE_BYTES=21474836480

# ---------- 可选：视频席位上限（Mesh 上行带宽防护）----------
# 全互联（Mesh）架构下，每个人的上行 = 同时开摄像头人数 − 1 路独立编码，
# 且每多一个人开视频，所有人就要多发一份、多编码一路 —— 瓶颈是
# 「同时开摄像头的人数」，不是在线人数。
# 该值限定同一时刻最多几人能开摄像头（含主持人），其余成员点开摄像头时
# 会收到「席位已满」提示并保持关闭；有人关闭后即可申请到席位。
# 默认 4，必须 ≥ 1。提高该值前请先确认所有人的上行带宽与 CPU 扛得住。
# MEETING_VIDEO_SEAT_LIMIT=4

# ---------- 可选：单会议总人数硬上限（Mesh 容量护栏）----------
# Mesh 全互联下每人要维护「人数 − 1」条连接，上行带宽与 CPU 随人数快速增长：
# 16 人时每人已要维护 15 条连接，开视频者的上行 = 15 × 单路码率。
# 该值限定单个会议的**总人数（含等候室）**，超出后 /join 直接拒绝（409），
# WebSocket 鉴权也会拒绝超编会议的连接。建会者占用第 1 个名额。
# 默认 16，必须 ≥ 1。调高前必须确认所有参会者的终端与网络扛得住。
# 各网络环境下的席位/画质建议见 README「媒体容量护栏与部署建议」一节。
# MEETING_MAX_PARTICIPANTS=16